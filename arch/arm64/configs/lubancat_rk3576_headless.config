# Headless robot config fragment for LubanCat-3 AMP (Linux + Cortex-M0 RT-Thread).
#
# Round 1 trimming: display outputs, on-board audio and Bluetooth only.
# Kept on purpose: DRM core (RKNPU DRM_GEM depends on it), GPU (Mali), NPU,
# camera/ISP, video codec (MPP/RGA), USB, WiFi, M0 UART5/RPMSG/AMP reservations.
#
# Applied via RK_KERNEL_CFG_FRAGMENTS; merged on top of
# arch/arm64/configs/lubancat_linux_rk3576_defconfig, then olddefconfig.

# ---- display: no local output (VOP / HDMI / DP / panels) ----
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
# CONFIG_ROCKCHIP_DRM_TVE is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_DW_MIPI_DSI is not set
# CONFIG_ROCKCHIP_DW_DP is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_RGB is not set
# CONFIG_ROCKCHIP_DW_HDCP2 is not set
# CONFIG_ROCKCHIP_DP_MST_AUX_CLIENT is not set
# CONFIG_ROCKCHIP_SERDES_DRM_PANEL is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_DISPLAY_CONNECTOR is not set
# CONFIG_DRM_SII902X is not set
# CONFIG_DRM_DW_HDMI_I2S_AUDIO is not set
# CONFIG_DRM_DW_HDMI_CEC is not set
# CONFIG_RK628_MISC is not set
# CONFIG_RK628_MISC_HDMITX is not set
# CONFIG_PHY_ROCKCHIP_DP is not set
# CONFIG_PHY_ROCKCHIP_INNO_HDMI is not set
# CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY is not set
# CONFIG_PHY_ROCKCHIP_NANENG_EDP is not set
# CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX is not set
# CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX_HDMI is not set
# CONFIG_VIDEO_ROCKCHIP_HDMIRX is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_TYPEC_DP_ALTMODE is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_BACKLIGHT_PWM is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is not set

# ---- audio: no on-board codec / HDMI-DP audio / headset ----
# CONFIG_SOUND is not set
# CONFIG_RK_HEADSET is not set

# ---- bluetooth (keep CONFIG_RFKILL / RFKILL_RK for WiFi) ----
# CONFIG_BT is not set

# ============================================================================
# Round 2 (2026-09-26)
# USB gadget off, CAN -> M0, WiFi narrowed to the on-board RTL8822CE, unused
# buses/filesystems/input/debug removed, GPU (Mali) off.
# Kept on purpose: MIPI CSI/ISP/VPSS/RGA, RTL8822CE WiFi, LED class + sys_led,
# DRM core (RKNPU DRM_GEM), PMIC (RK806) regulators, fan/thermal, evdev.
# ============================================================================

# ---- USB gadget / adb: OTG stays host-only (MaskRom flashing unaffected) ----
# CONFIG_USB_GADGET is not set

# ---- CAN is owned by the Cortex-M0 ----
# CONFIG_CAN is not set

# ---- WiFi: on-board RTL8822CE only (10ec:c822 / rtw_8822ce) ----
